# Copy to .env and fill in locally. Never commit real values.

# --- Database (existing Neon PostgreSQL; supplied by the project owner) ---
DATABASE_URL=
# Optional: direct (non-pooler) Neon URL for migrations. If empty, the migration
# runner derives it from DATABASE_URL by dropping the "-pooler" host suffix.
DATABASE_URL_DIRECT=

# --- API ---
API_PORT=4000
# Externally reachable API URL (local media delivery URLs in development).
API_PUBLIC_URL=http://localhost:4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API directly (never "*"). The web
# app calls the API server-side, so this can stay empty in production.
CORS_ORIGINS=http://localhost:3000
# TCP peers whose X-Forwarded-For is trusted for login rate limits (default: loopback = the web
# server on the same host). Add your reverse proxy / web host addresses in production.
TRUSTED_PROXY_IPS=

# --- Object storage ---
# local = files on disk under STORAGE_LOCAL_DIR (development only; refused when NODE_ENV=production)
# s3    = S3-compatible provider. Production: Hetzner Object Storage (fsn1).
#         PUBLIC media → S3_BUCKET_PUBLIC, PRIVATE files (meal-plan PDFs …) → S3_BUCKET_PRIVATE
#         (must differ; the private bucket is never public — files only via short-lived signed URLs).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# Hetzner example: S3_ENDPOINT=https://fsn1.your-objectstorage.com  S3_REGION=fsn1
#                  S3_BUCKET_PUBLIC=vitruv  S3_BUCKET_PRIVATE=vitruv-private
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
# Access keys from the Hetzner Cloud console (S3 credentials) — only in the server's .env, never committed.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true = path-style URLs (endpoint/bucket/key); Hetzner also supports virtual-hosted style (false).
S3_FORCE_PATH_STYLE=false
# Optional: "public-read" sets an object ACL on PUBLIC uploads (only if the public bucket has no
# read policy). Leave empty when the bucket itself is public.
S3_PUBLIC_OBJECT_ACL=
# Lifetime of signed URLs for private files, seconds (10–600, default 60).
PRIVATE_URL_TTL_SECONDS=60
# Base URL of public media. Empty = served through the API (${API_PUBLIC_URL}/media/<key>), which
# also keeps every older /media/public/… link working. With S3 you may point it at the public
# bucket/CDN, e.g. https://vitruv.fsn1.your-objectstorage.com — then add that origin to the web
# app's CMS_MEDIA_ORIGINS. Moving local files to S3: pnpm --filter @vitruv/api storage:migrate
PUBLIC_MEDIA_BASE_URL=
# Website media upload limits in bytes (defaults: 20 MB images, 100 MB videos).
MEDIA_MAX_IMAGE_BYTES=
MEDIA_MAX_VIDEO_BYTES=

# --- Authentication ---
# Real login: /v1/auth (docs/AUTH-ARCHITECTURE.md). First admin:
#   pnpm --filter @vitruv/api auth:bootstrap-admin -- --email=<address>   (password prompted)
# Non-interactive alternative (unset right after use, never commit):
BOOTSTRAP_ADMIN_PASSWORD=

# --- Development auth adapter (local API tooling only; refused when NODE_ENV=production) ---
# enabled = API requests carrying DEV_AUTH_TOKEN act as the users row DEV_AUTH_EMAIL
# (created by `pnpm --filter @vitruv/api seed:website`). The web Admin does NOT use it.
DEV_AUTH=disabled
DEV_AUTH_TOKEN=
DEV_AUTH_EMAIL=dev-admin@vitruv.invalid

# --- Public site revalidation (server-to-server, both API and web read it) ---
# After a publish the API POSTs to WEB_REVALIDATE_URL with REVALIDATE_SECRET (min. 32 chars).
REVALIDATE_SECRET=
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

# --- Web ---
# One canonical public base URL (canonical, Open Graph, sitemap, JSON-LD). https in production.
PUBLIC_SITE_URL=http://localhost:3000
# disabled = noindex + robots.txt disallow all (staging / preview deployments)
SITE_INDEXING=enabled
API_BASE_URL=http://localhost:4000
# Internal /design preview (design review). Always on in development; in production only when
# set to "enabled". The route is noindex and never linked from public navigation.
DESIGN_PREVIEW=disabled
# Header that YOUR hosting proxy sets to the browser IP (e.g. x-real-ip, cf-connecting-ip,
# x-vercel-forwarded-for). Forwarded to the API for login rate limits. Leave empty without one.
TRUSTED_CLIENT_IP_HEADER=
# next/image: allowed CMS media origins (comma-separated; default = API_BASE_URL origin).
# Add the public bucket/CDN origin here when PUBLIC_MEDIA_BASE_URL points at it.
CMS_MEDIA_ORIGINS=
# Development only (media on localhost). Never enable in production.
CMS_MEDIA_ALLOW_LOCAL=false
