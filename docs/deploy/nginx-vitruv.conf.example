# VITRUV — nginx EXAMPLE (Sprint 8B). Not deployed, not tested against the real server.
# Hostnames are PLACEHOLDERS (<SITE_HOST>, <API_HOST>) — the owner fills in the real ones.
# Apply on the server only after: nginx -t (dry run) and a backup of the current config.
#
# Goals: (1) signed video URLs never land in access logs, (2) no cache stores personal media,
# (3) Range requests pass through untouched, (4) one canonical site origin so the web app's
# strict origin check ("Forbidden: invalid request origin") is satisfied instead of disabled.

# ---- 1. log format without query strings -----------------------------------------------------
# $uri has no query string ($request / $request_uri would include ?u=&e=&s=).
log_format vitruv_noquery '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                          '$status $body_bytes_sent $request_time "$http_user_agent"';

# ---- 2. canonical site origin: every other host/scheme redirects to it ------------------------
server {
    listen 80;
    listen [::]:80;
    server_name <SITE_HOST> www.<SITE_HOST>;
    return 301 https://<SITE_HOST>$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.<SITE_HOST>;
    # ssl_certificate / ssl_certificate_key: existing certificates
    return 301 https://<SITE_HOST>$request_uri;
}

# Web (Next.js). PUBLIC_SITE_URL must be exactly https://<SITE_HOST> (no trailing slash).
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <SITE_HOST>;
    access_log /var/log/nginx/vitruv-web.access.log vitruv_noquery;

    location / {
        proxy_pass http://127.0.0.1:<WEB_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # the web app trusts ONE configured header for the client IP (TRUSTED_CLIENT_IP_HEADER)
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# ---- 3. API ------------------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <API_HOST>;
    access_log /var/log/nginx/vitruv-api.access.log vitruv_noquery;
    client_max_body_size 520m;   # video uploads (MEDIA_MAX_VIDEO_BYTES + headroom)

    # Signed, personal training media: never cached by nginx or any CDN in front of it; Range
    # requests and 206/302 answers pass through unchanged; no buffering of large bodies.
    location /v1/media/training/ {
        access_log /var/log/nginx/vitruv-api.access.log vitruv_noquery;
        proxy_pass http://127.0.0.1:<API_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        # the API already sends Cache-Control: private, no-store — do not override it here
    }

    location / {
        proxy_pass http://127.0.0.1:<API_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;   # streamed uploads
    }
}

# ---- 4. CDN (if one is put in front) — rules, not nginx syntax ---------------------------------
#  - BYPASS cache for /v1/media/training/* and /v1/* (dynamic, personal)
#  - do not strip or reorder the query string (signature!) and do not log it
#  - forward Range / If-Range; do not "optimise" video (transcoding breaks byte ranges)
#  - /media/public/* (website media) may be cached; it carries public cache headers
#
# Dry run on the server (owner):  sudo nginx -t   → only then: sudo systemctl reload nginx
# Verify after reload:  curl -sI "https://<API_HOST>/health"
#                       tail -n 5 /var/log/nginx/vitruv-api.access.log   (no "?u=" may appear)
