{
  "name": "@vitruv/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical VITRUV design tokens; generates Tailwind/CSS (web) and Dart (Flutter) outputs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "check": "tsx scripts/generate.ts --check",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitruv/config": "workspace:*",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "sideEffects": false
}
